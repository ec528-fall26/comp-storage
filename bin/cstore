#!/usr/bin/env bash
# Entry point for the cstore command line. Needs only python3 (3.10+); the
# heavy conversion dependencies live in the worker container image.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$REPO/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m cstore "$@"
